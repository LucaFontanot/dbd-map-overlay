{
  "name": "dbd-map",
  "desktopName": "dbd-map.desktop",
  "version": "1.7.2",
  "description": "Overlay for DBD maps",
  "main": "index.js",
  "author": "Luca <admin@lucaservers.com>",
  "scripts": {
    "test": "node --test test",
    "start": "npm run build:renderer && electron index.js",
    "prebuild": "bash scripts/prebuild.sh",
    "build": "npm run prebuild && npm run build:renderer && electron-builder -wl",
    "build:win": "npm run prebuild && npm run build:renderer && electron-builder -w",
    "build:linux": "npm run prebuild && npm run build:renderer && electron-builder -l",
    "publish": "npm run prebuild && npm run build:renderer && electron-builder -wl --publish always",
    "publish:win": "npm run prebuild && npm run build:renderer && electron-builder -w --publish always",
    "publish:linux": "npm run prebuild && npm run build:renderer && electron-builder -l --publish always",
    "ocr-test": "node scripts/ocr-test.js",
    "detector-test": "electron scripts/detector-test.js",
    "fetch-ocr-models": "node scripts/fetch-ocr-models.js",
    "build:renderer": "vite build",
    "dev:renderer": "vite build --watch --mode development"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "build": {
    "productName": "Dbd Map Overlay",
    "appId": "com.github.lucafontanot.dbdmapoverlay",
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Game",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "!static/*",
      "!scripts/*",
      "!dist/*",
      "!maps/*",
      "!.git/*",
      "!.idea/*",
      "!.github/*",
      "!.vscode/*",
      "!.yarn/*",
      "!src/renderer/**",
      "!vite.config.mjs",
      "!test/**",
      "!*.traineddata",
      "!:memory:.ses",
      "!**/*.md",
      "!picture-hash.js",
      "!AGENTS.md",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*/libonnxruntime_providers_*",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*/DirectML.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*/dxcompiler.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*/dxil.dll"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/node-screenshots/**/*.node",
      "node_modules/node-screenshots-*/**/*.node",
      "node_modules/onnxruntime-node/bin/**/*.node",
      "node_modules/onnxruntime-node/bin/**/*.so*",
      "node_modules/onnxruntime-node/bin/**/*.dll"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@vitejs/plugin-vue": "^5.2.4",
    "dompurify": "^3.4.17",
    "electron": "^40.4.1",
    "electron-builder": "^26.15.0",
    "marked": "^17.0.2",
    "vite": "^6.4.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.43",
    "vuetify": "^3.13.6"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "electron-updater": "^6.7.3",
    "image-size": "^2.0.2",
    "js-yaml": "^5.4.2",
    "node-screenshots": "^0.2.8",
    "onnxruntime-node": "^1.30.0",
    "paddleocr": "^1.2.0",
    "sharp": "^0.34.5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "^1.2.4",
    "@img/sharp-win32-x64": "^0.34.5"
  }
}
